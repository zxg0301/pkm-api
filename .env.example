# PostgreSQL
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/PKM

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=88888888
MINIO_REGION=us-east-1
MINIO_BUCKET=knowledgemap

# REST API Port
API_PORT=3001

# Memory API（默认关闭，不影响 /knowledge /attachments）
# MEMORY_API_ENABLED=true
# 启用后需执行: psql ... -f init-memory.sql

# Memory Tree 摘要器（可选，未来接 LLM）
# fallback | llm | auto（默认：有 API 配置则用 LLM，失败回退 fallback）
MEMORY_SUMMARIZER=auto
# OpenAI 兼容 Chat Completions 端点
# MEMORY_SUMMARIZER_API_URL=https://api.openai.com/v1/chat/completions
# MEMORY_SUMMARIZER_API_KEY=sk-...
# MEMORY_SUMMARIZER_MODEL=gpt-4o-mini
# MEMORY_SUMMARIZER_TIMEOUT_MS=120000
# MEMORY_SUMMARIZER_OUTPUT_LANGUAGE=zh-CN
